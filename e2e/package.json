{
  "name": "@crowd-pulse/e2e",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build:apps": "env VITE_API_URL=http://localhost:3100 REMOTE_QA_URL=http://localhost:4173/remoteEntry.js REMOTE_ANALYTICS_URL=http://localhost:5174/remoteEntry.js npm run build:all",
    "build:all": "npm run build -w @crowd-pulse/api && npm run build -w @crowd-pulse/qa && npm run build -w @crowd-pulse/analytics && npm run build -w @crowd-pulse/shell",
    "e2e": "playwright test",
    "e2e:full": "npm run build:apps && playwright test",
    "demo:record": "playwright test -c demo.config.ts",
    "demo:render": "node demo/compose.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
