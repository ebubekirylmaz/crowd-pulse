{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "REMOTE_QA_URL",
        "REMOTE_ANALYTICS_URL",
        "VITE_API_URL",
        "VITE_SITE_URL"
      ]
    },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "cache": false }
  }
}
