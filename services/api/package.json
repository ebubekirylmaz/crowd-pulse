{
  "name": "@crowd-pulse/api",
  "version": "0.0.1",
  "description": "API for the Crowd Pulse platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
